[Unit]
Description=Vamos Spanish learning web application (HTTP, static build via vite preview)
After=network-online.target vamos-api.service
Wants=network-online.target
Requires=vamos-api.service

[Service]
Type=simple
User=justin
Group=justin
WorkingDirectory=/home/justin/Projects/Espanol/frontend
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 5173 --strictPort
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
