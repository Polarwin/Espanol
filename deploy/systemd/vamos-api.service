[Unit]
Description=Vamos Spanish learning API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=justin
Group=justin
WorkingDirectory=/home/justin/Projects/Espanol
Environment=PYTHONUNBUFFERED=1
Environment=VAMOS_ENVIRONMENT=production
Environment=VAMOS_JWT_SECRET_FILE=/home/justin/Projects/Espanol/.secrets/jwt-secret
ExecStart=/home/justin/Projects/Espanol/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8011
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
