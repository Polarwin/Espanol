[Unit]
Description=Vamos Spanish learning web application (LAN HTTPS, static build via vite preview)
After=network-online.target vamos-api.service
Wants=network-online.target
Requires=vamos-api.service

[Service]
Type=simple
User=justin
Group=justin
WorkingDirectory=/home/justin/Projects/Espanol/frontend
Environment=VITE_LAN_HTTPS=true
Environment=VITE_LAN_CERT_DIR=/home/justin/Projects/Espanol/.certs
ExecStart=/usr/bin/npm run preview:https -- --host 0.0.0.0 --port 5174 --strictPort
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=default.target
