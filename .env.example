VAMOS_JWT_SECRET=replace-with-at-least-32-random-characters
VAMOS_DATABASE_URL=sqlite:///./vamos.db
VAMOS_LOG_FILE=./logs/vamos.log
VAMOS_WATCH_DIR=/srv/files/ytwatcher/Espanol
VAMOS_VITAMINA_DIR=/home/justin/Projects/Espanol/Vitamina
VAMOS_CORS_ORIGINS=["http://localhost:5173"]

# Frontend: set only when intentionally running the UI without a backend.
VITE_ENABLE_MOCKS=false
VAMOS_ENVIRONMENT=development
# Production: store a random 64+ character secret outside git and point here.
# VAMOS_JWT_SECRET_FILE=/absolute/path/to/jwt-secret
VAMOS_BACKUP_DIR=/absolute/path/to/database-backups
VAMOS_SPEECH_CACHE_MAX_FILES=256
VAMOS_SPEECH_CACHE_MAX_BYTES=134217728
