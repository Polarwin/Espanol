# Backend settings (all optional; defaults shown). Prefix: VAMOS_
# See backend/app/config.py for the authoritative list.

VAMOS_ENVIRONMENT=development
VAMOS_DATABASE_URL=sqlite:////home/justin/Projects/Espanol/vamos.db
VAMOS_CONTENT_DIR=/home/justin/Projects/Espanol/content
VAMOS_LOG_FILE=/home/justin/Projects/Espanol/logs/vamos.log
VAMOS_BACKUP_DIR=/home/justin/Projects/Espanol/backups
VAMOS_WATCH_DIR=/srv/files/ytwatcher/Espanol
VAMOS_VITAMINA_DIR=/home/justin/Projects/Espanol/Vitamina

# Auth. In production (VAMOS_ENVIRONMENT=production) startup fails unless the
# secret is a unique 64+ character value — store it outside git and point here.
VAMOS_JWT_SECRET=replace-with-at-least-64-random-characters
# VAMOS_JWT_SECRET_FILE=/absolute/path/to/jwt-secret
VAMOS_JWT_ALGORITHM=HS256
VAMOS_JWT_EXPIRE_MINUTES=10080

# Speech recognition / synthesis
VAMOS_WHISPER_MODEL=small
VAMOS_WHISPER_DEVICE=cpu
VAMOS_WHISPER_COMPUTE_TYPE=int8
VAMOS_SPEECH_CACHE_MAX_FILES=256
VAMOS_SPEECH_CACHE_MAX_BYTES=134217728

VAMOS_CORS_ORIGINS=["http://localhost:5173"]

# Frontend (frontend/.env): set only when intentionally running the UI without a backend.
VITE_ENABLE_MOCKS=false
