# Build-time env vars for the frontend (copy to .env / .env.production or
# export before `npm run build`). All optional — defaults match production.

# Origin the native (Capacitor) app calls for API/media requests.
# Baked into the bundle at build time; web builds use relative paths instead.
VITE_API_ORIGIN=https://espanol.justinrecipes.duckdns.org
